{
  "rules": {
    "bank": {
      ".read": "auth != null && auth.token.email === 'ofb.bay@gmail.com' && auth.token.email_verified === true",
      ".write": "auth != null && auth.token.email === 'ofb.bay@gmail.com' && auth.token.email_verified === true"
    },
    "games": {
      ".read": "auth != null && auth.token.email === 'ofb.bay@gmail.com' && auth.token.email_verified === true",
      "$code": {
        ".read": "root.child('games/' + $code + '/hostUid').exists()",
        ".write": "auth != null && auth.token.email === 'ofb.bay@gmail.com' && auth.token.email_verified === true && (!newData.exists() || (!data.exists() ? newData.child('hostUid').val() === auth.uid : data.child('hostUid').val() === auth.uid))",

        "players": {
          "$uid": {
            ".write": "root.child('games/' + $code + '/hostUid').exists()",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 24 && root.child('games/' + $code + '/config/groups').exists())"
          }
        },

        "picks": {
          "$q": {
            "$group": {
              ".write": "root.child('games/' + $code + '/state/phase').val() === 'question' && root.child('games/' + $code + '/state/qKey').val() === $q && root.child('games/' + $code + '/state/paused').val() !== true && now <= (root.child('games/' + $code + '/state/deadline/' + $group).exists() ? root.child('games/' + $code + '/state/deadline/' + $group).val() : root.child('games/' + $code + '/state/endsAt').val()) + 2000",
              ".validate": "newData.hasChildren(['opts', 'by', 'uid']) && root.child('games/' + $code + '/players/' + newData.child('uid').val() + '/group').val() === $group"
            }
          }
        },

        "jokers": {
          "$group": {
            "$key": {
              ".write": "!data.exists() && root.child('games/' + $code + '/state/phase').val() === 'question'",
              ".validate": "($key === 'pcr' || $key === 'alt' || $key === 'ptm' || $key === 're' || $key === 'sho' || $key === 'tel') && newData.val() === root.child('games/' + $code + '/state/qKey').val()"
            }
          }
        }
      }
    }
  }
}
